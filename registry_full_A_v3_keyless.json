{
  "meta": {
    "start_date_default": "2026-04-01",
    "mode": "A (daily snapshot; forward-fill non-daily)",
    "no_api_key": true,
    "notes": [
      "This registry avoids API keys by using: Stooq (market), HKMA Open API, HK C&SD API, US BLS v1, and China NBS RSS + HTML parsing.",
      "Some items on the original list are not reliably obtainable without licensed data or manual input (e.g., China fund daily sales total, some holdings/cash ratios). Those remain manual placeholders.",
      "Macro series are forward-filled to daily snapshots."
    ]
  },
